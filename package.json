{
    "name": "cartela",
    "version": "0.5.0",
    "description": "Headless print and video export for OpenLayers maps: sheet, legends, scale bar, graticule, PNG, PDF, MP4 and GIF.",
    "keywords": [
        "openlayers",
        "print",
        "export",
        "pdf",
        "png",
        "video",
        "gif",
        "legend",
        "scale-bar",
        "graticule",
        "headless",
        "gis"
    ],
    "license": "AGPL-3.0-only",
    "author": "Edgar Villarreal",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GHEgar/cartela.git"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./video": {
            "types": "./dist/video/index.d.ts",
            "import": "./dist/video/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config demo/vite.config.ts",
        "demo:build": "vite build --config demo/vite.config.ts",
        "e2e": "playwright test"
    },
    "peerDependencies": {
        "gifenc": ">=1.0.3",
        "mediabunny": ">=1.61",
        "ol": ">=10",
        "react": ">=19"
    },
    "peerDependenciesMeta": {
        "gifenc": {
            "optional": true
        },
        "mediabunny": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@npmegar/eslint-config": "^0.4.0",
        "@playwright/test": "^1.64.0",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "gifenc": "^1.0.3",
        "happy-dom": "^20.14.6",
        "mediabunny": "^1.61.4",
        "ol": "^10.11.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rotulo": "^0.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
